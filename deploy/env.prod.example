# Copy to .env in the repo root on the VM (gitignored), then fill in the secrets.
#     cp deploy/env.prod.example .env && nano .env

# Public address. Caddy gets the HTTPS certificate for it; the frontend is
# built against https://<this>. Changing it needs a rebuild of the frontend.
SITE_ADDRESS=34-100-196-59.sslip.io

# --- Database: the shared Atlas cluster (the same one Render reads) --------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.v3ux92w.mongodb.net/?retryWrites=true&w=majority
DB_NAME=hp_account_db
# "atlas" while MONGODB_URI is the Atlas cluster. "nano" once it points at a
# MongoDB without Atlas Vector Search; vectors then live in hp-backend/rag_storage.
# Change the two together - and switch back together to roll back.
VECTOR_STORAGE=atlas

# --- Self-hosted MongoDB (the `mongodb` service) ------------------------------
# Required: compose refuses to start without them. Generate each password with
#     openssl rand -hex 24
# (hex, so it needs no escaping inside MONGODB_URI). The users are created on
# the first start of an empty ~/hp-data/mongo; changing these later does not
# change the users. To move the backend onto it, set together:
#   MONGODB_URI=mongodb://<MONGO_APP_USER>:<MONGO_APP_PASSWORD>@mongodb:27017/hp_account_db?authSource=hp_account_db
#   VECTOR_STORAGE=nano
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=hpapp
MONGO_APP_PASSWORD=

# --- Auth ------------------------------------------------------------------
# ES256 signing key for access tokens. The backend refuses to start without it.
# Generate with: docker compose -f docker-compose.prod.yml run --rm backend python scripts/generate_jwt_key.py
# (or, from hp-backend: python scripts/generate_jwt_key.py) and paste the line here.
JWT_PRIVATE_KEY=
# Access tokens last 15 minutes; a session stays signed in for 7 days past its
# last use, 30 at most. Defaults shown; uncomment only to change them.
# ACCESS_TOKEN_MINUTES=15
# SESSION_IDLE_DAYS=7
# SESSION_MAX_DAYS=30

# --- LLM provider (gemini by default) -----------------------------------------
LLM_PROVIDER=vertex
VERTEX_PROJECT=
VERTEX_LOCATION=global
# Optional: chat regions to rotate over on 429 (gemini-2.5-flash, same model everywhere).
VERTEX_LOCATIONS=global,asia-south1,asia-southeast1,asia-northeast1,asia-northeast3,australia-southeast1
VERTEX_EMBEDDING_LOCATION=asia-south1
# Optional: spread embedding calls over several Asian regions (the limit is
# per region; vectors are identical everywhere, so no index rebuild).
VERTEX_EMBEDDING_LOCATIONS=asia-south1,asia-southeast1,asia-northeast1,asia-east1,asia-northeast3
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_RETRIEVAL_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=3072

# --- Cost and speed controls -----------------------------------------------
# A section that fails is never re-queued: it shows as Failed with its reason
# and runs again only when submitted. (A single model call still waits out a
# brief 429/5xx before giving up.)
# Gemini "thinking" tokens per call: 0 = off (faster, cheaper); -1 = model default.
GEMINI_THINKING_BUDGET=0
# Index builds: extraction calls in flight at once (speed vs quota), and
# LightRAG's second extraction pass per chunk (0 skips it: fewer calls).
RAG_LLM_MAX_ASYNC=2
RAG_EXTRACT_GLEANING=1
# Whether an insert extracts entities and relationships at all. Off: the
# Executive Dashboard answers in naive mode and reads chunk text only, so the
# graph cost a model call per chunk and was never read. true restores it, and
# the index's default_mode in retrieval/registry.py must go back to a graph
# mode with it.
RAG_BUILD_GRAPH=false

# --- Azure OpenAI (only with LLM_PROVIDER=openai) ------------------------------
OPENAI_API_KEY=
OPENAI_ENDPOINT=
OPENAI_MODEL_NAME=gpt-4o
OPENAI_RETRIEVAL_MODEL=gpt-5.6-sol

# --- Observability -----------------------------------------------------------
SERVICE_NAME=hp-backend
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json
