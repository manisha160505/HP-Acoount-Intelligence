r-engine.zip
transcript.txt
rag_storage/
**/rag_storage/
ingest/
.crg-venv/

# Private correspondence and bulk reference material kept locally only.
# Meeting notes under docs/meeting-notes/ are deliberately still tracked.
docs/mails*.txt
hp-project-flow.html

# Editor backups. Seven page.tsx.bak* snapshots were tracked, and the widget
# validator scanned them as if they were live UI - reporting a "Contract TBD"
# placeholder that had already been removed from page.tsx. Their history stays
# in git; only the working copies are ignored from here.
*.bak
*.bak[0-9]
*.bak[0-9][0-9]

# Standalone static lineage site + clickable replica, deployed separately to
# Vercel. Kept out of this repository: it carries a 649KB read-only capture of
# real account data (replica/assets/live.js) and is not part of the app build.
vercel app/

# Raw 220-account source data (exa, predictleads, google news, intent results,
# explorium). ~140MB of real client account data, internal only, never committed.
220 account data /

# Per-account CSVs produced from the above by scripts/split_account_data.py.
# Same client data in a different shape (~233MB), and regenerable from the
# source folder in about a minute, so it is derived output rather than input.
220 account split csv/

# Client documents (rulebooks, decks, spreadsheets, filings) shared for the
# 220-account work. Real client material, internal only, never committed.
NewDocs/

# Local tooling for splitting and validating the 220-account data above.
# Kept out of the repo alongside the data it reads.
scripts/split_account_data.py
scripts/split_baseline.json
scripts/validate_split_data.py

# ==============================================================================
# Local-only working folders (added 25 Sep). None of this is tracked today; the
# rules make that explicit so a stray `git add -A` cannot pick them up.
# ==============================================================================

# The delivered 220-account source data: explorium workbooks, exa, google news
# RSS, predictleads and the intent results. ~67MB of real client account data.
# Note the older "220 account data /" rule above names a folder that no longer
# exists, and carries a stray space before its slash; this is the live one.
220 accounts/

# Working archive of superseded drops and documents.
Archive/

# Project documentation kept locally rather than in the repository.
project-documentation/

