# ==============================================================================
# HP ACCOUNT INTELLIGENCE PLATFORM — TEMPLATE (.env.example)
# ==============================================================================

# Database & Security
#
# Local single-developer setup:
#   MONGODB_URI=mongodb://localhost:27017
#
# Shared cluster (Atlas) - the team inherits already-generated widgets, so no
# local MongoDB and no OpenAI key are needed just to see populated features.
# The password lives here and must never be committed; this machine's IP also
# has to be allowlisted in Atlas or every request fails.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=hp_account_db
JWT_SECRET=your-enterprise-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server Storage Directory for Account Uploads
DATA_STORAGE_DIR=data/accounts

# Reference File Paths (Local Filesystem Only)
SOURCE_A_EXCEL_PATH=Source A.xlsx
SOURCE_B_EXCEL_PATH=Source B.xlsx
GOOGLE_NEWS_EXCEL_PATH=google_news_rss_data.xlsx
FEATURES_SOURCING_DOC_PATH=11-Features-Sourcing-Reference-Anonymized.docx
MASTER_FASTAPI_STRUCTURE_PDF=Master FastAPI Project Structure.pdf
MASTER_NEXTJS_STRUCTURE_PDF=Master Next.js Project Structure.pdf

# 11 In-Scope Features List
IN_SCOPE_FEATURES=["Executive Dashboard","Recent News Signals","Stakeholder Map","Solution Narrative / Opportunity Map","Tech Landscape","Objection Playbook","Content Studio","Strategy Chat","Message Evaluator","Content Messaging","Intent & Demand Signals"]

# 23 Client Data Categories
DATASET_CATEGORIES=["firmographics","company_hierarchy","subsidiaries","funding","technographics","webstack","workforce_trends","company_ratings","website_traffic","social_media","intent_topics","intent_score","news_events","prospect_contacts","company","extended_company","job_openings","technology_detections","news_events_additional","connections","subpages","similar_companies","google_news"]

# Azure OpenAI (GPT-4o) — required for AI generation; the backend container
# reads these from this root .env via docker-compose env_file
OPENAI_API_KEY=your-azure-openai-api-key-here
OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/v1/
OPENAI_MODEL_NAME=gpt-4o
# The retrieval layer (LightRAG: entity extraction + answer synthesis) only.
# Leave empty to use OPENAI_MODEL_NAME above. Note this model does not accept a
# custom temperature - the client detects that and uses the default.
OPENAI_RETRIEVAL_MODEL=gpt-5.6-sol

# --- Observability -----------------------------------------------------------
# Identity stamped on every log record, span and metric. Set ENVIRONMENT to
# staging/production per deployment so a laptop's telemetry stays separable
# from the real thing in a shared log store.
SERVICE_NAME=hp-backend
SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Was hardcoded to INFO, so the
# debug calls already in the extractors were unreachable without a code edit.
LOG_LEVEL=INFO
# json  - one structured object per line; what Cloud Logging parses into
#         queryable fields. The default, so a deployed service is never
#         accidentally unstructured.
# plain - readable single lines. Set this locally if the JSON bothers you.
LOG_FORMAT=json

# Set to your GCP project id to turn on Cloud Trace and Cloud Monitoring
# export. Left empty, both stay off and the app logs normally - Cloud Logging
# still works on a deployed container, because the platform's built-in agent
# collects JSON on stdout without needing a client library.
GCP_PROJECT_ID=

# Master switch for tracing and metrics. Logging is unaffected by it.
OTEL_ENABLED=true
# An OTLP collector, if you use one instead of or alongside Google's backends.
# e.g. http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
# 1.0 traces every request. Fine at this traffic level; lower it if the trace
# bill or the ingest volume ever becomes a consideration.
OTEL_TRACE_SAMPLE_RATIO=1.0
# Cloud Monitoring rejects a custom metric written more often than once every
# 60s, so a shorter interval only wastes calls.
OTEL_METRIC_EXPORT_INTERVAL_MS=60000

# Frontend. NEXT_PUBLIC_* is inlined at build time and visible in the browser
# bundle - never put a secret here. Defaults to debug in dev and warn in a
# production build.
NEXT_PUBLIC_LOG_LEVEL=
