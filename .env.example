# ==============================================================================
# HP ACCOUNT INTELLIGENCE PLATFORM — TEMPLATE (.env.example)
# ==============================================================================

# Database & Security
#
# Local single-developer setup:
#   MONGODB_URI=mongodb://localhost:27017
#
# Shared cluster (Atlas) - the team inherits already-generated widgets, so no
# local MongoDB and no OpenAI key are needed just to see populated features.
# The password lives here and must never be committed; this machine's IP also
# has to be allowlisted in Atlas or every request fails.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=hp_account_db
JWT_SECRET=your-enterprise-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server Storage Directory for Account Uploads
DATA_STORAGE_DIR=data/accounts

# Reference File Paths (Local Filesystem Only)
SOURCE_A_EXCEL_PATH=Source A.xlsx
SOURCE_B_EXCEL_PATH=Source B.xlsx
GOOGLE_NEWS_EXCEL_PATH=google_news_rss_data.xlsx
FEATURES_SOURCING_DOC_PATH=11-Features-Sourcing-Reference-Anonymized.docx
MASTER_FASTAPI_STRUCTURE_PDF=Master FastAPI Project Structure.pdf
MASTER_NEXTJS_STRUCTURE_PDF=Master Next.js Project Structure.pdf

# 11 In-Scope Features List
IN_SCOPE_FEATURES=["Executive Dashboard","Recent News Signals","Stakeholder Map","Solution Narrative / Opportunity Map","Tech Landscape","Objection Playbook","Content Studio","Strategy Chat","Message Evaluator","Content Messaging","Intent & Demand Signals"]

# 23 Client Data Categories
DATASET_CATEGORIES=["firmographics","company_hierarchy","subsidiaries","funding","technographics","webstack","workforce_trends","company_ratings","website_traffic","social_media","intent_topics","intent_score","news_events","prospect_contacts","company","extended_company","job_openings","technology_detections","news_events_additional","connections","subpages","similar_companies","google_news"]

# Azure OpenAI (GPT-4o) — required for AI generation; the backend container
# reads these from this root .env via docker-compose env_file
OPENAI_API_KEY=your-azure-openai-api-key-here
OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/v1/
OPENAI_MODEL_NAME=gpt-4o
